#!/bin/sh /etc/rc.common
# AthenaWrt filebrowser：仅在真实 USB 分区挂载到 /mnt/usb 且 LAN 地址可用时启动。
# 初次启动生成随机密码并保存为 root-only 文件 /etc/filebrowser.password。
START=98
USE_PROCD=1

FB_BIN=/usr/bin/filebrowser
FB_DB=/etc/filebrowser-data.db
FB_PASS=/etc/filebrowser.password
FB_PORT=8081

lan_address() {
	local dev ip configured
	dev=$(uci -q get network.lan.device 2>/dev/null)
	[ -z "$dev" ] && dev=$(uci -q get network.lan.ifname 2>/dev/null)
	[ -z "$dev" ] && dev=br-lan
	configured=$(uci -q get network.lan.ipaddr 2>/dev/null)
	if [ -n "$configured" ]; then
		ip -4 -o addr show dev "$dev" 2>/dev/null | awk -v want="$configured" '{ split($4,a,"/"); if (a[1] == want) found=1 } END { exit !found }' || return 1
		ip="$configured"
	else
		ip=$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{ split($4,a,"/"); if (a[1] !~ /^169\.254\./ && a[1] != "127.0.0.1") { print a[1]; exit } }')
	fi
	[ -n "$ip" ] || return 1
	printf '%s' "$ip"
}

usb_mounted() {
	awk '$2 == "/mnt/usb" && $1 ~ /^\/dev\/sd[a-z][0-9]+$/ { found=1 } END { exit !found }' /proc/mounts 2>/dev/null
}

random_password() {
	od -An -N24 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n'
}

start_service() {
	local LAN_IP PASS
	[ -x "$FB_BIN" ] || { logger -t filebrowser "binary missing; service not started"; return 0; }
	usb_mounted || { logger -t filebrowser "USB partition is not mounted at /mnt/usb; service not started"; return 0; }
	[ -d /mnt/usb ] || { logger -t filebrowser "/mnt/usb is unavailable; service not started"; return 0; }
	LAN_IP=$(lan_address) || { logger -t filebrowser "LAN address unavailable; service not started"; return 0; }

	if [ ! -f "$FB_DB" ]; then
		"$FB_BIN" -d "$FB_DB" config init >/dev/null 2>&1 || {
			logger -t filebrowser "database initialization failed"
			return 1
		}
	fi

	# 首次部署或从旧版固定 root/admin 迁移时，生成随机密码并旋转默认管理员密码。
	# 密码只写入权限 0600 的本地文件，不写入日志。
	if [ ! -s "$FB_PASS" ]; then
		PASS=$(random_password)
		[ "${#PASS}" -eq 48 ] || { logger -t filebrowser "secure password generation failed"; return 1; }
		if ! "$FB_BIN" -d "$FB_DB" users update root --password "$PASS" >/dev/null 2>&1; then
			"$FB_BIN" -d "$FB_DB" users add root "$PASS" --perm.admin >/dev/null 2>&1 || {
				logger -t filebrowser "administrator initialization failed"
				return 1
			}
		fi
		( umask 077; printf '%s\n' "$PASS" > "$FB_PASS" ) || return 1
		chmod 600 "$FB_PASS" 2>/dev/null
	fi

	procd_open_instance
	procd_set_param command "$FB_BIN" -d "$FB_DB" -a "$LAN_IP" -p "$FB_PORT" -r /mnt/usb
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	procd_kill "$FB_BIN"
}
