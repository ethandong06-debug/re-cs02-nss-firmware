#!/bin/sh /etc/rc.common
# AthenaWrt FileBrowser Quantum：仅在 USB 分区挂载到 /mnt/usb 且 LAN 地址可用时启动。
# 首次启动密码随机生成并保存在 /etc/filebrowser.password（0600）。
START=98
USE_PROCD=1

FB_BIN=/usr/bin/filebrowser
FB_CONFIG=/etc/filebrowser-quantum.yaml
FB_DB=/etc/filebrowser-quantum.sqlite
FB_PASS=/etc/filebrowser.password
FB_PORT=8081
FB_CACHE=/mnt/usb/.athena-filebrowser-cache

lan_address() {
	local dev ip configured
	dev=$(uci -q get network.lan.device 2>/dev/null)
	[ -z "$dev" ] && dev=$(uci -q get network.lan.ifname 2>/dev/null)
	[ -z "$dev" ] && dev=br-lan
	configured=$(uci -q get network.lan.ipaddr 2>/dev/null)
	if [ -n "$configured" ]; then
		ip -4 -o addr show dev "$dev" 2>/dev/null | awk -v want="$configured" '{ split($4,a,"/"); if (a[1] == want) found=1 } END { exit !found }' || return 1
		ip="$configured"
	else
		ip=$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{ split($4,a,"/"); if (a[1] !~ /^169\.254\./ && a[1] != "127.0.0.1") { print a[1]; exit } }')
	fi
	[ -n "$ip" ] || return 1
	printf '%s' "$ip"
}

usb_mounted() {
	awk '$2 == "/mnt/usb" && $1 ~ /^\/dev\/sd[a-z][0-9]+$/ { found=1 } END { exit !found }' /proc/mounts 2>/dev/null
}

random_password() {
	od -An -N24 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n'
}

write_config() {
	local lan_ip="$1"
	cat > "$FB_CONFIG" <<EOF
http:
  listen: "$lan_ip"
  port: $FB_PORT
  disableRateLimit: false
server:
  database:
    path: "$FB_DB"
  cacheDir: "$FB_CACHE"
  sources:
    - path: "/mnt/usb"
      config:
        defaultEnabled: true
auth:
  adminUsername: "admin"
  methods:
    password:
      enabled: true
EOF
	chmod 600 "$FB_CONFIG"
}

start_service() {
	local LAN_IP PASS
	umask 077
	[ -x "$FB_BIN" ] || { logger -t filebrowser "Quantum binary missing; service not started"; return 0; }
	usb_mounted || { logger -t filebrowser "USB partition is not mounted at /mnt/usb; service not started"; return 0; }
	[ -d /mnt/usb ] || { logger -t filebrowser "/mnt/usb is unavailable; service not started"; return 0; }
	LAN_IP=$(lan_address) || { logger -t filebrowser "LAN address unavailable; service not started"; return 0; }

	if [ ! -s "$FB_PASS" ]; then
		PASS=$(random_password)
		[ "${#PASS}" -eq 48 ] || { logger -t filebrowser "secure password generation failed"; return 1; }
		( umask 077; printf '%s\n' "$PASS" > "$FB_PASS" ) || return 1
		chmod 600 "$FB_PASS"
	fi
	PASS=$(cat "$FB_PASS" 2>/dev/null)
	case "$PASS" in
		????????????????????????????????????????????????) ;;
		*) logger -t filebrowser "stored initial password has invalid length"; return 1 ;;
	esac
	case "$PASS" in *[!0-9a-f]*) logger -t filebrowser "stored initial password has invalid format"; return 1 ;; esac

	mkdir -p "$FB_CACHE" || { logger -t filebrowser "cache directory unavailable"; return 1; }
	chmod 700 "$FB_CACHE" 2>/dev/null
	write_config "$LAN_IP" || { logger -t filebrowser "Quantum config creation failed"; return 1; }
	chmod 600 "$FB_DB" 2>/dev/null

	procd_open_instance
	procd_set_param command /usr/libexec/athena-filebrowser-run.sh "$LAN_IP"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	procd_kill "$FB_BIN"
}
