#!/bin/sh /etc/rc.common
# AthenaWrt 文件共享：随机管理员密码、仅绑定 LAN 地址、仅开放 U 盘挂载目录。
START=98
USE_PROCD=1

FB_BIN=/usr/bin/filebrowser
FB_DB=/etc/filebrowser.db
FB_PORT=8081
FB_ROOT=/mnt/usb

start_service() {
	[ -x "$FB_BIN" ] || return 1
	/usr/libexec/athena-filebrowser.sh init >/dev/null 2>&1 || {
		logger -t filebrowser "安全初始化失败，拒绝启动文件共享服务"
		return 1
	}
	# 只绑定 br-lan 的管理地址，不监听 WAN/所有接口。
	LAN_IP=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk 'NR==1 {sub(/\/.*/, "", $4); print $4}')
	[ -n "$LAN_IP" ] || {
		logger -t filebrowser "未检测到 br-lan IPv4 地址，拒绝启动文件共享服务"
		return 1
	}
	mkdir -p "$FB_ROOT" || return 1
	chmod 700 "$FB_ROOT" 2>/dev/null
	procd_open_instance
	procd_set_param command "$FB_BIN" -c "$FB_DB" -a "$LAN_IP" -p "$FB_PORT" -r "$FB_ROOT"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	procd_kill "$FB_BIN"
}
